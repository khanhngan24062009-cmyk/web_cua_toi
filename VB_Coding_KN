          }
        }

        // Đổi hình nền cho từng trang
        switch (pageId) {
          case "home":           
            main.style.backgroundImage = "linear-gradient(135deg, #e3f2fd, #ffffff)";
            main.style.backgroundColor = "transparent";
            break;
          case "about":           
              main.style.backgroundImage = "linear-gradient(135deg, #e3f2fd, #ffffff)";
              main.style.backgroundColor = "transparent";
            break;
          case "goal":            
              main.style.backgroundImage = "linear-gradient(145deg, #e8f5e9, #ffffff)";
              main.style.backgroundColor = "transparent";
            break;
          case "solution":           
              main.style.backgroundImage = "linear-gradient(135deg, #e3f2fd, #ffffff)";
              main.style.backgroundColor = "transparent";
            break;
          case "result":            
              main.style.backgroundImage = "linear-gradient(160deg, #fff8e1 0%, #e3f2fd 70%)";
              main.style.backgroundColor = "transparent";
            break;
          case "product":
              main.style.backgroundImage = "url('nen-menu-san-pham.jpg')"; // https://live.staticflickr.com/65535/54908615928_4b7774ab46_m.jpg              
            break;
          case "games":
              main.style.backgroundImage = "url('nen-menu-tro-choi.jpg')"
             // main.style.backgroundImage = "none"; // Xóa hình nền
             // main.style.backgroundColor = "white"; // Đặt nền trắng
              break;
          case "contact":
              main.style.backgroundImage = "url('hinh-nhom-1.jpg')";
          break;
        } /*Đóng Switch*/
      } /*Đóng fution*/

      // Gọi mặc định khi tải trang lần đầu
      window.onload = () => showPage("home");
      function showGames() {
        // Hiển thị trang games
        showPage("games");

        // Ẩn iframe nếu có
        const iframe = document.querySelector("#games iframe");
        iframe.style.display = "none";
        iframe.src = "";

        // Hiển thị thông báo chào mừng
        const gamesDiv = document.getElementById("games");

        // Xóa thông báo cũ nếu có
        let notice = gamesDiv.querySelector(".notice");
        if (!notice) {
          notice = document.createElement("p");
          notice.className = "notice";
          notice.style.color = "#e00497";
          notice.style.fontWeight = "bold";
          notice.style.fontSize = "38px";
          00;
          /*notice.textContent = 'Chào mừng các bạn đến với trò chơi. Bạn chọn cấp học của mình trong menu trò chơi đi!'; Nằm trong một hàng*/
          notice.style.textAlign = "center"; // ⭐ canh giữa
          notice.style.marginTop = "140px"; // Tạo khoảng cách từ trên
          notice.style.lineHeight = "1.6"; // Khoảng cách giữa 2 câu
          notice.innerHTML =
            "🥰🥰🥰🥰🥰🥰🥰🥰🥰🥰🥰<br>Chào mừng các bạn đến với trò chơi!<br>Nhấp vào danh sách để chọn cấp học của bạn nhé! <br>🌺🌺🌺🌺🌺🌺🌺🌺🌺🌺🌺🌺🌺🌺🌺🌺🌺🌺🌺";
          /*Xuống hàng*/ let visible = true;
          setInterval(() => {
            if (visible) {
              notice.style.visibility = "hidden"; // ẩn đi
            } else {
              notice.style.visibility = "visible"; // hiện lại
            }
            visible = !visible;
          }, 600); // nhấp nháy 0.5 giây/lần

          // Thêm trước iframe
          gamesDiv.insertBefore(notice, iframe);
        } else {
          notice.style.display = "block";
        }

        // Tự động xóa thông báo sau 5 giây (5000ms)
        setTimeout(() => {
          if (notice) notice.style.display = "none";
        }, 2000);
      }
     
      // Mở trò chơi theo cấp học
      function moTroChoi(level) {
        showPage("games");
        const iframe = document.querySelector("#games iframe");
        if (level === "thpt") {
          iframe.src = "cay-nay-mam-thpt.html";
        } else if (level === "thcs") {
          iframe.src =
            "cay-nay-mam-thcs-25s.html"; /*iframe.src = 'cay-nay-mam-thcs-25ph.html';*/
        } else if (level === "tieuhoc") {
          iframe.src =
            "cay-nay-mam-tieu-hoc-25s.html"; /*iframe.src = 'cay-nay-mam-tieu-hoc-25ph.html';*/
        }
        iframe.style.display = "block";
      }

      function moSanPham(level) {
        const iframe = document.querySelector("#games iframe");
        if (!iframe) {
          console.error("⚠️ Iframe not found inside #games");
          return;
        }

        if (level === "fanpage") {
          window.open("https://www.facebook.com/share/1GTGw3njhG/", "_blank");
          return;
        }

        iframe.src = ""; // clear old
        iframe.style.display = "block"; // make visible first

        // set the new video
        if (level === "podcast") {
          iframe.src = "https://www.youtube.com/embed/XECl_eq6fkw";
        } else if (level === "lang") {
          iframe.src = "https://www.youtube.com/embed/F9jlZaWKaGo?start=583";
        } else if (level === "rise") {
          iframe.src = "https://www.youtube.com/embed/uJ_81NCLBdU?start=5";
        }

        // now reveal the page
        showPage("games");
      }
