<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MindDawn Tan Mây Sáng</title>
    <link rel="stylesheet" href="style.css" />
    <style>
      /* Reset mặc định */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
        /* Cụm nút liên hệ ở góc phải phía trên footer */
        .contact-buttons {
          position: fixed;
          right: 30px; /* khoảng cách 3 nút trên footer bên phải */
          bottom: 10px; /* khoảng cách 3 nút trên footer bên dưới */
          display: flex;
          flex-direction: row;
          gap: 12px;
          z-index: 999;
        }

        /* Nút tròn */
        .contact-btn {
          width: 50px; /* Kích thước nút chiều ngang */
          height: 50px; /* Kích thước nút chiều đ */
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 24px;
          color: white;
          text-decoration: none;
          box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
          transition: transform 0.3s ease, opacity 0.3s ease;
          animation: pulse 1s infinite;
        }

        /* Màu riêng cho từng nút */
        .contact-btn.phone {
          background-color: #28a745;
        } /* Xanh lá gọi điện */
        .contact-btn.zalo {
          background-color: #00b7ff;
        } /* Xanh Zalo */
        .contact-btn.messenger {
          background-color: #006aff;
        } /* Xanh Messenger */

        /* Hiệu ứng hover */
        .contact-btn:hover {
          transform: scale(1.15);
          opacity: 0.9;
        }

        /* 🔆 Hiệu ứng nhấp nháy nhẹ */
        @keyframes pulse {
          0% {
            box-shadow: 0 0 0 0 rgba(255, 255, 255, 1);
          }
          70% {
            box-shadow: 0 0 0 25px rgba(255, 255, 255, 0);
          }
          100% {
            box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
          }
        }      

      html,
      body {
        /*Bố cục web hiện đại vì không che nội dung, mà vẫn giữ footer ở đáy khi trang ngắn*/
        height: 100%; /*Chiều cao toàn màn hình*/
        margin: 0;
        padding: 0;
        display: flex; /*Dùng Flexbox để bố cục cột*/
        flex-direction: column; /*Sắp xếp các phần tử dọc: header → main → footer*/
      }

      iframe {
        width: 100vw; /* Chiều ngang toàn màn hình */
        height: 100vh; /* Chiều cao toàn màn hình */
        border: none;
        border-radius: 0; /* Không bo góc để khít viền màn hình */
        box-shadow: none;
        display: block;
      }

      /* --- Phần đầu nội dung --- */
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f6f8;
        /*background-image: url('https://live.staticflickr.com/65535/54918034916_49ac67b739_m.jpg'); /* đường dẫn đến ảnh của bạn */
        font-size: 20px; /*Cỡ chữ cho dòng đầu tiên của phần body*/
        color: #060104; /*Màu cho phần nội dung dưới tiêu đề - phần p*/
        line-height: 1.6; /*Giãn cách dòng trong phần thân*/
      }

      /* --- Phần đầu trang --- */
      header {
        background-color: #0078d7; /*Màu nền cho phần đầu trang web*/
        color: white; /*Màu chữ trong phần header*/
        padding: 50px 0; /*Chiều cao của phần header*/
        text-align: center; /*Canh lề cho nội dung trong phần header*/
        font-size: 24px; /*Cỡ chữ cho phần header*/
        font-weight: bold; /*Định dạng chữ đậm cho phần header*/
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
      }

      /* Phần này bỏ không ảnh hưởng */
      header h1 {
        font-size: 48px; /*Kích cỡ chữ cho phần đầu header 1*/
        font-weight: bold;
        margin-bottom: 10px;
        /*background-color: hsl(158, 100%, 42%); /*Màu nền cho phần đầu tiêu đề trang web*/
      }

      /* --- COVER PAGE --- */
      .cover-page {
        height: 80vh; /* Chiều cao toàn màn hình */
        min-height: 20vh; /* Cao hơn 1.2 lần màn hình */
        background-image: url("https://live.staticflickr.com/65535/54918034916_49ac67b739_m.jpg"); /* Đường dẫn đến ảnh của bạn */
        background-size: cover; /* Ảnh phủ kín toàn bộ */
        background-position: center; /* Căn giữa ảnh */
        background-repeat: no-repeat; /* Không lặp lại ảnh */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: 22px;
        line-height: 1.2;
        color: rgb(8, 123, 77); /* Màu phủ mờ (tuỳ chọn) */
        /*background-color: rgba(0, 0, 0, 0.5); /* Màu phủ mờ (tuỳ chọn) */
      }

      /* Chữ chạy Cover page*/
      .cover-page {
        height: 80vh;
        background-image: url("https://live.staticflickr.com/65535/54918034916_49ac67b739_m.jpg");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        margin: 0;
        overflow: hidden; /* Ẩn phần chữ ra ngoài */
      }

      /* Khung chứa chữ chạy dòng trên */
      .text-container {
        width: 100%;
        overflow: hidden;
        white-space: nowrap;
      }

      /* Chữ chạy + đổi màu liên tục */
      .text-run {
        display: inline-block;
        font-size: 2em;
        font-weight: bold;
        text-transform: uppercase;
        background: linear-gradient(
          90deg,
          #ff0057,
          #f8aa02,
          #03de12,
          #08aae0,
          #ff00c8,
          #1904db,
          #006aff
        );
        background-size: 400%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: moveText 8s linear infinite, colorShift 1s linear infinite; /*Tốc độ chạy chữ*/
      }

      /* hiệu ứng chạy ngang */
      @keyframes moveText {
        0% {
          transform: translateX(100%);
        }
        100% {
          transform: translateX(-100%);
        }
      }

      /* hiệu ứng đổi màu chữ */
      @keyframes colorShift {
        0% {
          background-position: 0% 50%;
        }
        100% {
          background-position: 100% 50%;
        }
      }

      /* ✨ Dòng dưới nhấp nháy liên tục */
      .blink-text {
        font-size: 1.3em;
        margin-top: 18px;
        color: #fee503; /* vàng sáng */
        font-size: 32px;
        font-weight: bold;
        text-shadow: 0 0 5px #ff0000, 0 0 16px #ff5722;
        animation: blink 3s step-start infinite;
      }

      /* Tạo hiệu ứng nhấp nháy */
      @keyframes blink {
        40% {
          opacity: 0;
        }
      }

      /* --- Thanh điều hướng --- */
      nav {
        background-color: #034edb; /*Màu nền menu*/
        display: flex;
        justify-content: center;
        gap: 50px; /*Khoảng cách các chữ trên thanh điều hướng*/
        padding: 10px 0;
      }

      nav a {
        color: white; /*Màu chữ trên thanh điều hướng*/
        text-decoration: none;
        font-weight: 500;
        font-size: 20px;
        transition: color 0.3s, transform 0.3s;
      }

      nav a:hover {
        color: #08bcdc; /*Đổi màu khi rê chuột*/
        transform: scale(1.1); /*Tăng nhẹ kích thước*/
      }

      /* Dropdown (menu con của Trò chơi) */
      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-content {
        display: none;
        position: absolute;
        background-color: white;
        min-width: 180px; /*Khoảng cách chiều ngang của hộp thoại xuất hiện trong hộp danh sách*/
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        border-radius: 6px;
        z-index: 1;
      }

      .dropdown-content a {
        color: black;
        padding: 10px 14px; /*Khoảng cách cách các chữ trong hộp danh sách*/
        display: block;
        text-decoration: none;
        font-size: 18px; /*Cỡ chữ trong danh sách*/
        line-height: 1.0;
      }

      .dropdown-content a:hover {
        background-color: #11d9e7;
      }

      .dropdown:hover .dropdown-content {
        display: block;
      }

      /* --- Thân trang --- */
      main {
        flex: 1; /*Đẩy footer xuống đáy nếu nội dung ít*/
        padding: 0px 0; /*Khoảng cách chừa lề trên trong phần nội dung*/
        text-indent: 40px; /*Thụt đầu dòng 1 tab cho đoạn văn*/
        width: 100%; /*Chiều rộng tối đa của trang web dùng chứa nội dung*/
        /*background: #f0f0f0; /*Màu nền của phần thân trang web*/
        /*background-image: url('https://live.staticflickr.com/65535/54907229783_8fbc4f0d89_m.jpg'); /* đường dẫn đến ảnh 1 của bạn */
        background-image: url("https://live.staticflickr.com/65535/54907229798_2a40068441_m.jpg"); /* đường dẫn đến ảnh 2 của bạn */
        border-radius: 10px; /*Góc cong cho phần thân trang web*/
        background-repeat: no-repeat;
        /*background-size: contain; /* hiển thị hết hình, có thể còn khoảng trống */
        background-size: cover; /* phủ kín toàn bộ khung hình */
        background-position: center; /* căn giữa hình */
        /*background-attachment: fixed; /* cố định hình khi cuộn trang (tuỳ chọn) */
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        min-height: 3000px; /*Chiều cao của trang web dùng chứa nội dung*/
      }

      .container {
        max-width: 1000px;
        margin: 0 30px;
      }

      main h2 {
        /*Phần tiêu đề trong phần nội dung*/
        margin-top: 20px;
        color: #0853ea; /*Màu cho dòng tiêu đề trong phần nội dung*/
        padding-left: 30px;
        margin-bottom: 20px; /*Khoảng cách phía sau dòng tiêu đề h2*/
      }

      main p {
        /*Phần nội dung*/
        margin-bottom: 15px; /*Khoảng cách trống bên dưới mỗi đoạn*/
        text-align: justify; /*Canh lề đều hai bên*/
      }

      /* --- Chân trang --- */

      /* Ẩn nội dung khi chưa được chọn */
      .page {
        display: none;
        background-color: url("https://live.staticflickr.com/65535/54907455155_9ff01eb8b2_m.jpg"); /* hình nền khác nhau body-menu thì dùng background-image*/
        border-radius: 10px;
        padding: 0px;
        max-width: 100vw;
        margin: auto;
      }

      .active {
        display: block;
      }

      /* 🔸 Bố cục 2 cột cho phần sản phẩm */
      .product-section {
        display: flex; /* Hiển thị dạng hàng ngang */
        align-items: flex-start; /* Căn đỉnh 2 khối thẳng hàng */
        justify-content: space-between;
        gap: 30px; /* Khoảng cách giữa 2 cột */
        flex-wrap: wrap; /* Tự xuống dòng nếu màn hình nhỏ */
        margin: 20px 40px; /* Chừa lề 2 bên */
      }

      /* 🔸 Cột trái: phần nội dung mô tả */
      .product-text {
        flex: 1; /* Chiếm 1 phần linh hoạt */
        min-width: 280px; /* Giữ kích thước tối thiểu khi co lại */
        font-size: 18px;
        font-family: "Times New Roman", Times, serif;
        line-height: 1.7;
      }

      /* 🔸 Cột phải: phần video */
      .product-video {
        flex: 1; /* Chiếm 1 phần linh hoạt */
        min-width: 50px;
        text-align: center;
      }

      /* 🔸 xxxxx: xxxxx */
      .product-video iframe {
        width: 50%;
        height: fit-content;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
      }

      /* 🔸 xxxxx: xxxxx */
      .banner {
        background-image: url("https://live.staticflickr.com/65535/54907455155_9ff01eb8b2_m.jpg"); /*Hình Cô Ngọc*/
        /*background-image: url('https://live.staticflickr.com/65535/54907229783_8fbc4f0d89_m.jpg');/*Hình KN1*/
        /*background-image: url('https://live.staticflickr.com/65535/54907229798_2a40068441_m.jpg');/*Hình KN2*/
        background-size: cover;
        background-position: center;
        width: 99vw;
        height: 180px;
        line-height: 1.4;
        aspect-ratio: 5 / 1; /* tự co chiều cao theo màn hình */
        border-radius: 0px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
      }

      .banner-text {
        color: rgb(11, 99, 68);
        font-size: 36px; /*Kích thước chữ trên trang cover*/
        font-weight: bold;
        text-align: center;
        width: 100%; /* 🟢 giúp chữ và nền phủ toàn chiều ngang */
        padding: 20px 20px; /* thêm khoảng cách trên dưới */
        background: rgba(0, 0, 0, 0.069); /* Làm nền mờ trong phần đầu tiên */
        border-radius: 20px; /* nếu muốn 4 góc bo tròn, giữ 20px */
        position: absolute; /* giúp chữ nổi giữa ảnh */
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%); /* căn giữa hoàn hảo */
        z-index: 1;
        display: flex; /* giúp căn giữa cả chiều ngang */
        justify-content: center; /* căn giữa nội dung */
        align-items: center; /* căn giữa theo trục dọc */
      }
      
      /* ===== Footer Styles ===== */
      footer {
        position: fixed;
        left: 0;
        bottom: 0;
        width: 100%;
        background-color: #0077b6;
        color: white;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px 10px;
        font-size: 16px;
        z-index: 100;
        box-sizing: border-box;
      }

      /* ===== Responsive Font Sizes ===== */
      @media (max-width: 768px) {
        footer {
          font-size: 14px;
          padding: 12px 8px;
        }
      }

      @media (max-width: 480px) {
        footer {
          font-size: 12px;
          padding: 10px 6px;
          text-align: center;
          flex-direction: column; /* stack text for tiny screens */
        }
      }
     
      body {
        margin: 0;
        font-family: "Lato", sans-serif;
      }

      /* ======== Desktop Navbar ======== */
      nav {
        background-color: #0077b6;
        display: flex;
        justify-content: center; /* Center nav-links */
        align-items: center;
        padding: 0 20px;
        position: relative;
        z-index: 100;
      }

      .nav-links {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      nav a {
        color: white;
        text-decoration: none;
        padding: 14px 16px;
        display: block;
        font-size: 18px;
      }

      nav a:hover {
        background-color: #005f87;
      }

      /* ======== Logo (Hide on Desktop) ======== */
      .logo {
        color: white;
        font-size: 20px;
        font-weight: bold;
        display: none; /* hidden by default */
      }

      /* ======== Dropdown (Desktop) ======== */
      .dropdown {
        position: relative;
      }

      .dropdown-content {
        display: none;
        position: absolute;
        background-color: #0077b6;
        min-width: 200px;
        z-index: 200;
      }

      .dropdown-content a {
        color: white;
        padding: 12px 16px;
        display: block;
        text-align: left;
      }

      .dropdown-content a:hover {
        background-color: #005f87;
      }

      .dropdown:hover .dropdown-content {
        display: block;
      }

      /* ======== Mobile Sidebar ======== */
      .sidenav {
        height: 100%;
        width: 0;
        position: fixed;
        z-index: 1001;
        top: 0;
        left: 0;
        background-color: #111;
        overflow-x: hidden;
        transition: 0.4s;
        padding-top: 60px;
      }

      .sidenav a {
        padding: 10px 30px;
        text-decoration: none;
        font-size: 20px;
        color: #ccc;
        display: block;
        transition: 0.3s;
      }

      .sidenav a:hover {
        color: #fff;
      }

      .submenu {
        display: none;
        background-color: #222;
        margin-left: 20px;
      }

      .submenu a {
        font-size: 18px;
        padding-left: 40px;
      }

      .expandable {
        cursor: pointer;
        position: relative;
      }

      .expandable::after {
        content: "▸";
        position: absolute;
        right: 30px;
        transition: transform 0.3s;
      }

      .expandable.active::after {
        transform: rotate(90deg);
      }

      /* ======== Hamburger Icon ======== */
      .menu-icon {
        display: none;
        flex-direction: column;
        cursor: pointer;
        position: absolute;
        right: 20px;
      }

      .menu-icon div {
        width: 25px;
        height: 3px;
        background-color: white;
        margin: 4px 0;
      }

      /* ======== Overlay ======== */
      .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.3);
        display: none;
        z-index: 1000;
      }

      /* ======== Responsive ======== */
      @media screen and (max-width: 768px) {
        nav {
          justify-content: space-between; /* show logo + menu icon */
          padding: 0 20px;
        }

        .logo {
          display: block; /* show only on mobile */
        }

        .nav-links {
          display: none; /* hide desktop links on mobile */
        }

        .menu-icon {
          display: flex;
        }
      }
    </style>
  </head>
  <body>
    <!-- Đầu trang -->

    <!-- Cover Page -->
    <section class="cover-page">
      <div class="text-container">
        <h1 class="text-run">
          🌿Chào mừng bạn đến với trang web của chúng tôi🌿
        </h1>
      </div>
      <p class="blink-text">👉 💖Khám phá nhiều điều thú vị bên dưới💖 👇</p>
    </section>

    <nav>
      <!-- Only visible on mobile -->
      <div class="logo">MindDawn</div>

      <div class="nav-links">
        <a href="#" onclick="showPage('home')">Trang chủ</a>
        <a href="#" onclick="showPage('about')">Giới thiệu</a>
        <a href="#" onclick="showPage('goal')">Mục tiêu</a>
        <a href="#" onclick="showPage('solution')">Giải pháp</a>
        <a href="#" onclick="showPage('result')">Kết quả</a>

        <div class="dropdown">
          <a href="#" onclick="showPage('product')" class="dropbtn"
            >Sản phẩm ▾</a
          >
          <div class="dropdown-content">
            <a href="#" onclick="moSanPham('fanpage')">Fanpage: “Trời xanh”</a>
            <a href="#" onclick="moSanPham('podcast')">Podcast: “Giữ tâm”</a>
            <a href="#" onclick="moSanPham('lang')">Sổ “Lặng”</a>
            <a href="#" onclick="moSanPham('rise')">Sổ “Rise”</a>
          </div>
        </div>

        <div class="dropdown">
          <a href="#" onclick="showGames()" class="dropbtn">Trò chơi ▾</a>
          <div class="dropdown-content">
            <a href="#" onclick="moTroChoi('thpt')">THPT</a>
            <a href="#" onclick="moTroChoi('thcs')">THCS</a>
            <a href="#" onclick="moTroChoi('tieuhoc')">Tiểu học</a>
          </div>
        </div>

        <a href="#" onclick="showPage('contact')">Liên hệ</a>
      </div>

      <!-- Hamburger icon -->
      <div class="menu-icon" onclick="openNav()">
        <div></div>
        <div></div>
        <div></div>
      </div>
    </nav>

    <!-- ======== OVERLAY ======== -->
    <div id="overlay" class="overlay" onclick="closeNav()"></div>

    <!-- ======== SIDEBAR (Mobile Menu) ======== -->
    <div id="mySidenav" class="sidenav" onclick="event.stopPropagation()">
      <a href="#" onclick="showPage('home')">Trang chủ</a>
      <a href="#" onclick="showPage('about')">Giới thiệu</a>
      <a href="#" onclick="showPage('goal')">Mục tiêu</a>
      <a href="#" onclick="showPage('solution')">Giải pháp</a>
      <a href="#" onclick="showPage('result')">Kết quả</a>

      <a class="expandable" onclick="showPage('product')">Sản phẩm</a>
      <div class="submenu">
        <a href="#" onclick="moSanPham('fanpage')">Fanpage: “Trời xanh”</a>
        <a href="#" onclick="moSanPham('podcast')">Podcast: “Giữ tâm”</a>
        <a href="#" onclick="moSanPham('lang')">Sổ “Lặng”</a>
        <a href="#" onclick="moSanPham('rise')">Sổ “Rise”</a>
      </div>

      <a class="expandable" onclick="showGames()">Trò chơi</a>
      <div class="submenu">
        <a href="#" onclick="moTroChoi('thpt')">THPT</a>
        <a href="#" onclick="moTroChoi('thcs')">THCS</a>
        <a href="#" onclick="moTroChoi('tieuhoc')">Tiểu học</a>
      </div>
      <a href="#" onclick="showPage('contact')">Liên hệ</a>
